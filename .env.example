# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public origin this deployment is served from — must be an absolute http(s)
# URL. Social preview (Open Graph) image URLs are resolved against it, so a
# wrong value means link previews point somewhere unreachable. Set it per
# deployment: production gets the real domain, previews get their own host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stellar network: testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Deployed tip_splitter contract ID
NEXT_PUBLIC_TIP_SPLITTER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# USDC Stellar Asset Contract ID
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
