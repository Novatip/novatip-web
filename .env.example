# ── Required ──────────────────────────────────────────────────────────────────
# Variables marked REQUIRED must be set before running `npm run dev` or
# `npm run build`. The app will throw a descriptive error at startup if any
# of them are absent or malformed.

# Soroban contract ID of the deployed tip_splitter contract.
# Must be a 56-character Stellar contract address starting with "C".
# REQUIRED — the app cannot process tips without it.
NEXT_PUBLIC_TIP_SPLITTER_CONTRACT_ID=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Optional — safe defaults for local development ────────────────────────────
# These have built-in fallbacks that work out of the box with `npm run dev`.
# Override them in staging/production deployments.

# Backend API base URL.
# Default: http://localhost:3001/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Public origin this deployment is served from.
# Used as metadataBase so Open Graph image URLs resolve correctly.
# Must be an absolute http(s) URL — e.g. https://novatip.xyz
# A malformed value fails the build with a clear error message.
# Default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stellar network to connect to: testnet | mainnet
# Default: testnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# USDC Stellar Asset Contract ID.
# The default is the canonical USDC SAC address used on both testnet and mainnet.
# Only override this if you are running against a custom local network.
# Default: CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
